# Browser-accessible backend URL. Set this before building the Next.js app.
NEXT_PUBLIC_API_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# Optional server-only backend URL for public-site page rendering.
# Use the same URL as NEXT_PUBLIC_API_URL unless the server has a private API address.
API_URL=http://localhost:5000

# Public portfolio origin, used when linking to the site from the admin app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
